{
  "name": "pr-comment",
  "description": "pr-comment action that shows changes in PR",
  "version": ".0.0",
  "main": "dist/index.js",
  "author": "Alexisinho",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/Alexisinho/pr-comment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexisinho/pr-comment.git"
  },
  "bugs": {
    "url": "https://github.com/Alexisinho/pr-comment/issues"
  },
  "keywords": [
    "actions",
    "Pull Request",
    "Comment"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "package": "rimraf ./dist && rollup --config rollup.config.js",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "test": "jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "rollup": "^4.0.0"
  }
}